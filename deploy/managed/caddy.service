[Unit]
Description=OurDealsHub LAN HTTPS front end
After=network-online.target ourdealshub-managed.service
Wants=network-online.target
[Service]
User=haris
Group=haris
EnvironmentFile=/opt/ourdealshub-managed/.env
Environment=XDG_DATA_HOME=/var/lib/ourdeals-caddy
Environment=XDG_CONFIG_HOME=/var/lib/ourdeals-caddy-config
ExecStart=/usr/local/bin/ourdeals-caddy run --config /opt/ourdealshub-managed/current/deploy/managed/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/ourdeals-caddy reload --config /opt/ourdealshub-managed/current/deploy/managed/Caddyfile --adapter caddyfile
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
