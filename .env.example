DATABASE_URL="postgresql://ourdealshub:ourdealshub@localhost:5432/ourdealshub?schema=public"
# Use a long random secret (≥32 chars). Required in production.
NEXTAUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
AUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@ourdealshub.com"
# Never use change-me / admin123 in production (boot check will fail).
ADMIN_PASSWORD="use-a-strong-unique-password"
ADMIN_NAME="Super Admin"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Public contact email (privacy + /contact). Defaults to hello@<your-domain>.
CONTACT_EMAIL="hello@ourdealshub.com"

# Amazon Product Advertising API (server-only — never expose to the browser)
# Partner / tracking tags are stored per admin in the database (Admins).
# AMAZON_PARTNER_TAG is optional legacy fallback only — prefer per-admin IDs.
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_PARTNER_TAG=""
AMAZON_PAAPI_HOST="webservices.amazon.com"
AMAZON_PAAPI_REGION="us-east-1"
AMAZON_MARKETPLACE="www.amazon.com"

# Google Gemini (server-only — never expose to the browser)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Protects GET /api/cron/daily (schedule publish + Telegram digest)
# Use Bearer header only — do NOT put the secret in the URL (?secret=)
# Example: curl -H "Authorization: Bearer $CRON_SECRET" "$SITE/api/cron/daily"
# Windows: powershell -ExecutionPolicy Bypass -File scripts/windows-cron-daily.ps1
CRON_SECRET="generate-a-long-random-cron-secret"

# Optional error reporting (Sentry DSN). Leave empty to disable.
SENTRY_DSN=""

# Backup: npm run db:backup  → ./backups/*.sql
# Keep backups/ out of git.

# ---------------------------------------------------------------------------
# Self-hosted (Docker) — docker-compose.prod.yml only. See docs/DEPLOY.md.
# In that stack DATABASE_URL above is overridden to point at the "db" service.
# NEXT_PUBLIC_SITE_URL / AUTH_URL / NEXTAUTH_URL must be https://<SITE_DOMAIN>.
# ---------------------------------------------------------------------------
# Postgres password for the compose "db" service (long random value)
POSTGRES_PASSWORD=""
# Hostname Caddy serves, e.g. ourdeals.lan (local) or ourdealshub.com
SITE_DOMAIN=""
# "internal" = Caddy's local CA (LAN testing); an email = Let's Encrypt (public domain)
CADDY_TLS="internal"
